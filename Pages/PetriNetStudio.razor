@page "/petri-nets"
@using System.Text.Json
@using PNMarking = UltraDES.PetriNets.Marking
@using PNTransition = UltraDES.PetriNets.Transition
@inject IJSRuntime JSRuntime

<div class="petri-workspace">
    <header class="petri-topbar">
        <a class="petri-brand" href=""><img src="/UltraDES/img/logo.png" alt="UltraDES" /><span><strong>UltraDES</strong><small>Petri-net Workspace</small></span></a>
        <div class="petri-actions">
            <nav class="workspace-switcher" aria-label="Modeling workspace">
                <a href=""><i class="fas fa-project-diagram"></i><span>Automata</span></a>
                <a class="is-active" href="petri-nets" aria-current="page"><i class="fas fa-network-wired"></i><span>Petri nets</span></a>
            </nav>
            <div class="dropdown is-hoverable">
                <button class="button" aria-haspopup="true"><span>Create <i class="fas fa-angle-down"></i></span></button>
                <div class="dropdown-menu"><div class="dropdown-content">
                    <button class="dropdown-item" @onclick="() => BeginNode(WorkspaceMode.Place)">Places</button>
                    <button class="dropdown-item" @onclick="() => BeginNode(WorkspaceMode.Transition)">Transitions</button>
                    <button class="dropdown-item" @onclick="NewNet">Petri net</button>
                    <button class="dropdown-item" @onclick="NewMarking" disabled="@(nets.Count == 0)">Marking</button>
                </div></div>
            </div>
            <div class="dropdown is-hoverable">
                <button class="button" aria-haspopup="true"><span>Operations <i class="fas fa-angle-down"></i></span></button>
                <div class="dropdown-menu"><div class="dropdown-content">
                    <button class="dropdown-item" @onclick="ShowDrawing" disabled="@(selected is null)">Show selected net</button>
                    <button class="dropdown-item" @onclick="() => ShowCoverability(false)" disabled="@(selected is null || !HasMarking())">Coverability graph</button>
                    <button class="dropdown-item" @onclick="() => ShowCoverability(true)" disabled="@(selected is null || !HasMarking())">Coverability tree</button>
                    <button class="dropdown-item" @onclick="OpenSimulation" disabled="@(selected is null || !HasMarking())">Simulation</button>
                </div></div>
            </div>
            <div class="dropdown is-hoverable">
                <button class="button" aria-haspopup="true"><span>Examples <i class="fas fa-angle-down"></i></span></button>
                <div class="dropdown-menu"><div class="dropdown-content">
                    <button class="dropdown-item" @onclick="LoadResourceExample">Resource allocation</button>
                </div></div>
            </div>
        </div>
    </header>

    <main class="petri-shell">
        <aside class="petri-sidebar">
            <div class="workspace-heading"><div><span class="eyebrow">Current project</span><h1>Petri nets</h1></div><span class="workspace-total">@(places.Count + transitions.Count + nets.Count)</span></div>
            @Catalog("Places", "fa-circle", places, WorkspaceMode.Place)
            @Catalog("Transitions", "fa-minus", transitions, WorkspaceMode.Transition)
            <section class="catalog"><div class="catalog-title"><span>Nets</span><span class="item-count">@nets.Count</span><button @onclick="NewNet" title="Create net" aria-label="Create net"><i class="fas fa-plus"></i></button></div>
                @if (nets.Count == 0) { <p class="catalog-empty">No nets created.</p> }
                @foreach (var net in nets) { <button class="catalog-item @(selected == net ? "is-active" : "")" @onclick="() => Select(net)"><i class="fas fa-project-diagram"></i><span><strong>@net.Name</strong><small>@net.Places.Length places · @net.Transitions.Length transitions</small></span></button> }
            </section>
            <section class="catalog"><div class="catalog-title"><span>Markings</span><span class="item-count">@markings.Count</span><button @onclick="NewMarking" disabled="@(nets.Count == 0)" title="Create marking" aria-label="Create marking"><i class="fas fa-plus"></i></button></div>
                @if (markings.Count == 0) { <p class="catalog-empty">No associated markings.</p> }
                @foreach (var marking in markings) { <button class="catalog-item" @onclick="() => EditMarking(marking)"><i class="fas fa-coins"></i><span><strong>@marking.Name</strong><small>@marking.NetName</small></span></button> }
            </section>
        </aside>

        <section class="petri-content">
            @if (!string.IsNullOrWhiteSpace(error)) { <div class="notification is-danger" role="alert"><button class="delete" @onclick="() => error = string.Empty"></button>@error</div> }
            @if (mode == WorkspaceMode.Place || mode == WorkspaceMode.Transition) { @NodeEditor() }
            else if (mode == WorkspaceMode.Net) { @NetEditor() }
            else if (mode == WorkspaceMode.Marking) { @MarkingEditor() }
            else if (selected is not null) { @NetDetails() }
            else { <div class="petri-welcome"><span class="welcome-icon"><i class="fas fa-network-wired"></i></span><span class="eyebrow">Build workflow</span><h2>Model your net step by step.</h2><p>Create the basic elements, connect them with arcs, and use markings to analyze and simulate the net behavior.</p><div class="petri-welcome-actions"><button class="button is-primary" @onclick="() => BeginNode(WorkspaceMode.Place)"><i class="far fa-circle"></i><span>Create first place</span></button><button class="button is-light" @onclick="() => BeginNode(WorkspaceMode.Transition)"><i class="fas fa-minus"></i><span>Create transition</span></button></div><div class="steps"><span><b>1</b> Places</span><i class="fas fa-chevron-right"></i><span><b>2</b> Transitions</span><i class="fas fa-chevron-right"></i><span><b>3</b> Net and arcs</span><i class="fas fa-chevron-right"></i><span><b>4</b> Marking</span></div></div> }
        </section>
    </main>
</div>

@if (simulationOpen && selected is not null && currentMarking is not null)
{
    <Modal Title="@($"Simulation — {selected.Name}")" OnClose="CloseSimulation">@Simulation()</Modal>
}

@code {
    private const string StorageKey = "ultrades.petrinets.workspace.v2";
    private readonly List<string> places = [];
    private readonly List<string> transitions = [];
    private readonly List<PetriNetDraft> nets = [];
    private readonly List<MarkingDraft> markings = [];
    private PetriNetDraft selected;
    private MarkingDraft editingMarking;
    private WorkspaceMode mode;
    private string nodeName = "", netName = "", markingName = "", markingNet = "", error = "", svg = "", analysis = "";
    private readonly HashSet<string> selectedPlaces = [];
    private readonly HashSet<string> selectedTransitions = [];
    private readonly List<ArcRow> arcRows = [];
    private readonly Dictionary<string, uint> tokenEditor = [];
    private PNMarking currentMarking;
    private bool simulationOpen;
    private readonly List<string> firingHistory = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", StorageKey); if (!string.IsNullOrWhiteSpace(json)) Load(JsonSerializer.Deserialize<WorkspaceData>(json)); }
        catch (Exception ex) { error = $"The saved workspace could not be loaded: {ex.Message}"; }
        StateHasChanged();
    }

    private RenderFragment Catalog(string title, string icon, List<string> items, WorkspaceMode target) => @<section class="catalog"><div class="catalog-title"><span>@title</span><span class="item-count">@items.Count</span><button @onclick="() => BeginNode(target)" title="Create @title.ToLowerInvariant()" aria-label="Create @title.ToLowerInvariant()"><i class="fas fa-plus"></i></button></div>@if (items.Count == 0) { <p class="catalog-empty">No items created.</p> }@foreach (var item in items) { <div class="catalog-item"><i class="far @icon"></i><span><strong>@item</strong></span><button class="delete is-small" title="Delete @item" aria-label="Delete @item" @onclick="() => DeleteNode(item, target)"></button></div>}</section>;

    private RenderFragment NodeEditor() => @<div class="editor-card"><span class="eyebrow">Step @(mode == WorkspaceMode.Place ? "1" : "2")</span><h2>Create @(mode == WorkspaceMode.Place ? "place" : "transition")</h2><p>These elements will be available for use in one or more nets.</p><div class="field"><label class="label">Names</label><input class="input" @bind="nodeName" @onkeyup="EnterNode" placeholder="e.g. @(mode == WorkspaceMode.Place ? "idle, busy" : "start, finish")" /></div><div class="buttons"><button class="button is-primary" @onclick="SaveNode">Create</button><button class="button" @onclick="CancelEditor">Cancel</button></div></div>;

    private RenderFragment NetEditor() => @<div class="editor-card wide"><span class="eyebrow">Step 3</span><h2>@(selected is null ? "Build a net" : $"Edit {selected.Name}")</h2><div class="field"><label class="label">Net name</label><input class="input" @bind="netName" /></div><div class="node-picker-grid"><div><h3>Places</h3>@foreach (var place in places) { <label class="node-option"><input type="checkbox" checked="@selectedPlaces.Contains(place)" @onchange="e => Toggle(selectedPlaces, place, e.Value)"/><i class="far fa-circle"></i>@place</label> }</div><div><h3>Transitions</h3>@foreach (var transition in transitions) { <label class="node-option"><input type="checkbox" checked="@selectedTransitions.Contains(transition)" @onchange="e => Toggle(selectedTransitions, transition, e.Value)"/><i class="fas fa-minus"></i>@transition</label> }</div></div><div class="section-heading"><div><h3>Arcs</h3><p>Always connect a place to a transition, or a transition to a place.</p></div><button class="button is-small is-light" @onclick="AddArc"><i class="fas fa-plus"></i>&nbsp; Add arc</button></div>@foreach (var row in arcRows) { <div class="petri-row"><div class="select is-fullwidth"><select @bind="row.Origin"><option value="">Origin</option>@foreach(var n in AvailableNodes()) { <option>@n</option> }</select></div><span>→</span><div class="select is-fullwidth"><select @bind="row.Destination"><option value="">Destination</option>@foreach(var n in AvailableNodes()) { <option>@n</option> }</select></div><input class="input weight" type="number" min="1" @bind="row.Weight" title="Weight"/><button class="button is-danger is-light" @onclick="() => arcRows.Remove(row)"><i class="fas fa-trash"></i></button></div>}<div class="buttons mt-5"><button class="button is-primary" @onclick="SaveNet">Save net</button><button class="button" @onclick="CancelEditor">Cancel</button></div></div>;

    private RenderFragment MarkingEditor() => @<div class="editor-card"><span class="eyebrow">Step 4</span><h2>@(editingMarking is null ? "Create marking" : "Edit marking")</h2><p>A marking is independent and associated with a net, allowing different initial states.</p><div class="field"><label class="label">Marking name</label><input class="input" @bind="markingName" /></div><div class="field"><label class="label">Associated net</label><div class="select is-fullwidth"><select value="@markingNet" @onchange="ChangeMarkingNet">@foreach(var net in nets) { <option value="@net.Name">@net.Name</option> }</select></div></div><div class="marking-editor">@foreach(var place in MarkingPlaces()) { <label><span>@place</span><input class="input" type="number" min="0" value="@tokenEditor.GetValueOrDefault(place)" @onchange="e => SetToken(place,e.Value?.ToString())"/></label> }</div><div class="buttons mt-5"><button class="button is-primary" @onclick="SaveMarking">Save marking</button><button class="button" @onclick="CancelEditor">Cancel</button>@if(editingMarking is not null){<button class="button is-danger is-light" @onclick="DeleteMarking">Delete</button>}</div></div>;

    private RenderFragment NetDetails() => @<div class="net-details"><div class="details-head"><div><span class="eyebrow">Selected net</span><h2>@selected!.Name</h2><p>@selected.Places.Length places · @selected.Transitions.Length transitions · @selected.Arcs.Length arcs</p></div><div class="buttons"><button class="button" @onclick="EditNet"><i class="fas fa-edit"></i>&nbsp; Edit</button><button class="button is-danger is-light" @onclick="DeleteNet"><i class="fas fa-trash"></i></button></div></div><div class="action-grid"><button @onclick="ShowDrawing"><i class="fas fa-project-diagram"></i><span><strong>Show net</strong><small>View places, transitions, and arcs</small></span></button><button @onclick="() => ShowCoverability(false)" disabled="@(!HasMarking())"><i class="fas fa-share-alt"></i><span><strong>Coverability graph</strong><small>Calculate and show reachable states</small></span></button><button @onclick="() => ShowCoverability(true)" disabled="@(!HasMarking())"><i class="fas fa-sitemap"></i><span><strong>Coverability tree</strong><small>Show the marking expansion</small></span></button><button @onclick="OpenSimulation" disabled="@(!HasMarking())"><i class="fas fa-play"></i><span><strong>Simulate</strong><small>Fire transitions in a dialog</small></span></button></div>@if(!HasMarking()){<div class="notification is-info is-light">Create a marking associated with this net to run graphs, trees, and simulations.</div>}@if(!string.IsNullOrWhiteSpace(svg)){<div class="result-panel"><div class="result-title"><h3>Result</h3><button class="delete" @onclick="ResetViews"></button></div><div class="petri-drawing">@((MarkupString)svg)</div>@if(!string.IsNullOrWhiteSpace(analysis)){<p>@analysis</p>}</div>}</div>;

    private RenderFragment Simulation() => @<div class="simulation"><div class="field"><label class="label">Initial marking</label><div class="select is-fullwidth"><select @onchange="ChangeSimulationMarking">@foreach(var marking in AssociatedMarkings()) { <option value="@marking.Name">@marking.Name</option> }</select></div></div><h4>Current marking</h4><div class="marking-chips">@foreach(var value in currentMarking!.Values.OrderBy(v=>v.Item1.ToString())){<span><strong>@value.Item1</strong> = @(value.Item2?.ToString() ?? "ω")</span>}</div><h4>Enabled transitions</h4><div class="buttons">@foreach(var transition in Built(CurrentSimulationMarking()).Net.EnabledTransitions(currentMarking)){<button class="button is-primary" @onclick="() => Fire(transition)"><i class="fas fa-play"></i>&nbsp; @transition</button>}@if(!Built(CurrentSimulationMarking()).Net.EnabledTransitions(currentMarking).Any()){<span class="tag is-warning">Deadlock: no enabled transitions</span>}</div>@if(firingHistory.Count>0){<p><strong>Sequence:</strong> @string.Join(" → ",firingHistory)</p>}<button class="button is-light" @onclick="ResetSimulation"><i class="fas fa-redo"></i>&nbsp; Reset</button></div>;

    private void BeginNode(WorkspaceMode target) { mode=target; nodeName=""; ResetViews(); }
    private async Task EnterNode(KeyboardEventArgs e) { if(e.Key=="Enter") await SaveNode(); }
    private async Task SaveNode()
    {
        try
        {
            var names = PetriNetWorkspace.ParseNames(nodeName);
            if (names.Length == 0) throw new InvalidOperationException("Enter at least one name.");
            var collision = names.FirstOrDefault(name => places.Contains(name) || transitions.Contains(name));
            if (collision is not null) throw new InvalidOperationException($"An element already exists named '{collision}'.");
            (mode == WorkspaceMode.Place ? places : transitions).AddRange(names);
            mode = WorkspaceMode.None;
            await Persist();
        }
        catch(Exception ex) { error=ex.Message; }
    }
    private async Task DeleteNode(string item, WorkspaceMode target) { if(nets.Any(n=>n.Places.Contains(item)||n.Transitions.Contains(item))){error="This element belongs to a net. Edit or delete the net before removing it.";return;} (target==WorkspaceMode.Place?places:transitions).Remove(item); await Persist(); }
    private void NewNet(){selected=null;netName="";selectedPlaces.Clear();selectedTransitions.Clear();arcRows.Clear();mode=WorkspaceMode.Net;ResetViews();}
    private void EditNet(){netName=selected!.Name;selectedPlaces.Clear();selectedPlaces.UnionWith(selected.Places);selectedTransitions.Clear();selectedTransitions.UnionWith(selected.Transitions);arcRows.Clear();arcRows.AddRange(selected.Arcs.Select(a=>new ArcRow(a.Origin,a.Destination,a.Weight)));mode=WorkspaceMode.Net;}
    private void Toggle(HashSet<string> set,string value,object state){if(state is true)set.Add(value);else set.Remove(value);}
    private IEnumerable<string> AvailableNodes()=>selectedPlaces.Concat(selectedTransitions).OrderBy(x=>x);
    private void AddArc()=>arcRows.Add(new());
    private async Task SaveNet(){try{var draft=new PetriNetDraft(netName.Trim(),selectedPlaces.ToArray(),selectedTransitions.ToArray(),arcRows.Select(a=>new PetriArcDraft(a.Origin,a.Destination,a.Weight)).ToArray(),new());PetriNetWorkspace.Build(draft);if(nets.Any(n=>n!=selected&&n.Name==draft.Name))throw new InvalidOperationException("A net with this name already exists.");var old=selected?.Name;if(selected is not null)nets.Remove(selected);nets.Add(draft);if(old is not null)foreach(var m in markings.Where(m=>m.NetName==old))m.NetName=draft.Name;selected=draft;mode=WorkspaceMode.None;await Persist();}catch(Exception ex){error=ex.Message;}}
    private async Task DeleteNet(){if(selected is null)return;markings.RemoveAll(m=>m.NetName==selected.Name);nets.Remove(selected);selected=null;ResetViews();await Persist();}
    private void Select(PetriNetDraft net){selected=net;mode=WorkspaceMode.None;ResetViews();}
    private void CancelEditor(){mode=WorkspaceMode.None;editingMarking=null;}
    private void NewMarking(){editingMarking=null;markingName="";markingNet=selected?.Name??nets[0].Name;tokenEditor.Clear();mode=WorkspaceMode.Marking;}
    private void EditMarking(MarkingDraft marking){editingMarking=marking;markingName=marking.Name;markingNet=marking.NetName;tokenEditor.Clear();foreach(var pair in marking.Tokens)tokenEditor[pair.Key]=pair.Value;mode=WorkspaceMode.Marking;}
    private void ChangeMarkingNet(ChangeEventArgs e){markingNet=e.Value?.ToString()??"";tokenEditor.Clear();}
    private string[] MarkingPlaces()=>nets.FirstOrDefault(n=>n.Name==markingNet)?.Places??[];
    private void SetToken(string place,string value)=>tokenEditor[place]=uint.TryParse(value,out var count)?count:0;
    private async Task SaveMarking(){try{if(string.IsNullOrWhiteSpace(markingName))throw new InvalidOperationException("Enter the marking name.");if(markings.Any(m=>m!=editingMarking&&m.Name==markingName))throw new InvalidOperationException("A marking with this name already exists.");var draft=new MarkingDraft(markingName.Trim(),markingNet,MarkingPlaces().ToDictionary(p=>p,p=>tokenEditor.GetValueOrDefault(p)));if(editingMarking is not null)markings.Remove(editingMarking);markings.Add(draft);editingMarking=null;mode=WorkspaceMode.None;await Persist();}catch(Exception ex){error=ex.Message;}}
    private async Task DeleteMarking(){markings.Remove(editingMarking!);editingMarking=null;mode=WorkspaceMode.None;await Persist();}
    private bool HasMarking()=>AssociatedMarkings().Any();
    private IEnumerable<MarkingDraft> AssociatedMarkings()=>markings.Where(m=>m.NetName==selected?.Name);
    private MarkingDraft CurrentSimulationMarking()=>markings.First(m=>m.Name==simulationMarkingName&&m.NetName==selected!.Name);
    private string simulationMarkingName="";
    private (UltraDES.PetriNets.PetriNet Net,PNMarking Marking) Built(MarkingDraft marking)=>PetriNetWorkspace.Build(selected! with { InitialMarking=marking.Tokens });
    private async Task ShowDrawing(){try{ResetViews();var marking=AssociatedMarkings().FirstOrDefault();var built=PetriNetWorkspace.Build(selected! with {InitialMarking=marking?.Tokens??new()});svg=await JSRuntime.InvokeAsync<string>("GraphViz",built.Net.ToDotCode(marking is null?null:built.Marking));}catch(Exception ex){error=ex.Message;}}
    private async Task ShowCoverability(bool tree){try{ResetViews();var built=Built(AssociatedMarkings().First());var edges=built.Net.CoverabilityGraph(built.Marking).ToArray();var body=tree?string.Join(" ",edges.Select((e,i)=>$"\"n{i}a:{e.Item1}\" -> \"n{i}b:{e.Item3}\" [label=\"{e.Item2}\"];")):string.Join(" ",edges.Select(e=>$"\"{e.Item1}\" -> \"{e.Item3}\" [label=\"{e.Item2}\"];"));var dot=$"digraph G {{ rankdir={(tree?"TB":"LR")}; node [shape=box]; {body} }}";svg=await JSRuntime.InvokeAsync<string>("GraphViz",dot);analysis=$"{edges.Length} arcs in the {(tree?"tree unfolding":"coverability graph")}. ω represents unbounded growth.";}catch(Exception ex){error=ex.Message;}}
    private void OpenSimulation(){simulationOpen=true;simulationMarkingName=AssociatedMarkings().First().Name;ResetSimulation();}
    private void CloseSimulation(){simulationOpen=false;currentMarking=null;firingHistory.Clear();}
    private void ChangeSimulationMarking(ChangeEventArgs e){simulationMarkingName=e.Value?.ToString()??"";ResetSimulation();}
    private void ResetSimulation(){currentMarking=Built(CurrentSimulationMarking()).Marking;firingHistory.Clear();}
    private void Fire(PNTransition transition){currentMarking=Built(CurrentSimulationMarking()).Net.Fire(currentMarking!,transition);firingHistory.Add(transition.ToString());}
    private async Task LoadResourceExample()
    {
        const string exampleName = "Resource allocation";
        var existing = nets.FirstOrDefault(net => net.Name == exampleName);
        if (existing is not null) { Select(existing); return; }
        var examplePlaces = new[] { "available", "busy" };
        var exampleTransitions = new[] { "acquire", "release" };
        if (examplePlaces.Concat(exampleTransitions).Any(name => places.Contains(name) || transitions.Contains(name)))
        {
            error = "The example cannot be loaded because one of its element names is already in use.";
            return;
        }
        places.AddRange(examplePlaces);
        transitions.AddRange(exampleTransitions);
        var net = new PetriNetDraft(exampleName, examplePlaces, exampleTransitions,
            [new("available", "acquire", 1), new("acquire", "busy", 1), new("busy", "release", 1), new("release", "available", 1)], new());
        nets.Add(net);
        markings.Add(new MarkingDraft("One available resource", exampleName, new() { ["available"] = 1, ["busy"] = 0 }));
        Select(net);
        await Persist();
    }
    private void ResetViews(){svg="";analysis="";error="";}
    private async Task Persist()=>await JSRuntime.InvokeVoidAsync("localStorage.setItem",StorageKey,JsonSerializer.Serialize(new WorkspaceData(places,transitions,nets,markings)));
    private void Load(WorkspaceData data){if(data is null)return;places.AddRange(data.Places??[]);transitions.AddRange(data.Transitions??[]);nets.AddRange(data.Nets??[]);markings.AddRange(data.Markings??[]);}
    private enum WorkspaceMode { None, Place, Transition, Net, Marking }
    private sealed class ArcRow(string origin="",string destination="",uint weight=1){public string Origin{get;set;}=origin;public string Destination{get;set;}=destination;public uint Weight{get;set;}=weight;}
    private sealed record WorkspaceData(List<string> Places,List<string> Transitions,List<PetriNetDraft> Nets,List<MarkingDraft> Markings);
    private sealed class MarkingDraft
    {
        public MarkingDraft() { }
        public MarkingDraft(string name,string netName,Dictionary<string,uint> tokens){Name=name;NetName=netName;Tokens=tokens;}
        public string Name { get; set; } = "";
        public string NetName { get; set; } = "";
        public Dictionary<string,uint> Tokens { get; set; } = [];
    }
}
