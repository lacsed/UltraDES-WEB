
<div class="modal is-active" role="dialog" aria-modal="true" aria-labelledby="@titleId" @onkeydown="HandleKey" tabindex="-1">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title" id="@titleId">@Title</p>
            <button type="button" class="delete" aria-label="Close dialog" autofocus @onclick="OnClose"></button>
        </header>
        <section class="modal-card-body">
            @ChildContent
        </section>
    </div>
</div>
@code {
    private readonly string titleId = $"modal-title-{Guid.NewGuid():N}";
    [Parameter] public string Title { get; set; }
    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private Task HandleKey(KeyboardEventArgs args) => args.Key == "Escape" ? OnClose.InvokeAsync() : Task.CompletedTask;
}
