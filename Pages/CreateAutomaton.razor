@using global::UltraDES

@inject AutomatonDraftValidator Validator

<div class="automaton-form">
    @if (States.Count == 0 || Events.Count == 0)
    {
        <div class="notification is-info is-light" role="status">Create at least one state and one event before building an automaton.</div>
    }
    <div class="field transition-count-field">
        <label class="label" for="transition-count-range">Number of transitions <span class="tag is-info is-light">@transitionsNum</span></label>
        <div class="transition-count-controls">
            <input type="range" min="1" max="25" id="transition-count-range" aria-label="Number of transitions" @bind="transitionsNum">
            <input type="number" min="1" max="25" class="input" id="transition-count-number" aria-label="Number of transitions as a number" @bind="transitionsNum">
        </div>
    </div>
    <div class="transition-editor" aria-label="Transitions">
        @for (var l = 0; l < transitionsNum; l++)
        {
            var i = l;
            <fieldset class="transition-row">
                <legend>Transition @(i + 1)</legend>
                <div class="field"><label class="label" for="origin-@i">Origin</label><div class="select is-fullwidth"><select id="origin-@i" @bind="@transitions[i, 0]"><option value="">Choose state</option>@foreach (var q in States){<option value="@q.Key">@q.Key</option>}</select></div></div>
                <span class="transition-arrow" aria-hidden="true">→</span>
                <div class="field"><label class="label" for="event-@i">Event</label><div class="select is-fullwidth"><select id="event-@i" @bind="@transitions[i, 1]"><option value="">Choose event</option>@foreach (var e in Events){<option value="@e.Key">@e.Key</option>}</select></div></div>
                <span class="transition-arrow" aria-hidden="true">→</span>
                <div class="field"><label class="label" for="destination-@i">Destination</label><div class="select is-fullwidth"><select id="destination-@i" @bind="@transitions[i, 2]"><option value="">Choose state</option>@foreach (var q in States){<option value="@q.Key">@q.Key</option>}</select></div></div>
            </fieldset>
        }
    </div>
    <div class="field">
        <label class="label" for="initial-state">Initial state</label>
        <div class="select is-fullwidth">
            <select id="initial-state" @bind="@initial"><option value="">Choose state</option>@foreach (var q in States){<option value="@q.Key">@q.Key</option>}</select>
        </div>
    </div>
    <div class="field">
        <label class="label" for="automaton-name">Automaton name</label>
        <div class="control">
            <input type="text" class="input" id="automaton-name" @bind="name" autocomplete="off">
        </div>
    </div>
    @if (errors.Count > 0)
    {
        <div class="notification is-danger" role="alert"><strong>Please correct the following:</strong><ul>@foreach (var message in errors) { <li>@message</li> }</ul></div>
    }
    <div class="buttons">
        <button type="button" class="button is-primary" disabled="@(States.Count == 0 || Events.Count == 0)" @onclick="Create">Create automaton</button>
        <button type="button" class="button" @onclick="OnCancel">Cancel</button>
    </div>
</div>

@code {
    [Parameter] public Func<DeterministicFiniteAutomaton, bool> OnSuccess { get; set; }
    [Parameter] public Action OnCancel { get; set; }
    [Parameter]public Dictionary<string, AbstractState> States { get; set; }
    [Parameter]public Dictionary<string, AbstractEvent> Events { get; set; }

    private string name = "";
    private string initial = "";
    private int transitionsNum = 1;
    private readonly string[,] transitions = new string[100, 3];
    private readonly List<string> errors = new();
    [Parameter] public IEnumerable<string> ExistingAutomatonNames { get; set; } = Array.Empty<string>();

    protected override void OnInitialized()
    {
        for (int i = 0; i < transitions.GetLength(0); i++)
            for (int j = 0; j < transitions.GetLength(1); j++)
                transitions[i, j] = "";
    }

    private void Create()
    {
        errors.Clear();
        var draft = new AutomatonDraftValidator.Draft(name,
            States.Select(q => new AutomatonDraftValidator.StateDraft(q.Key, q.Key, q.Value.IsMarked)).ToArray(),
            Events.Select(e => new AutomatonDraftValidator.EventDraft(e.Key, e.Key, e.Value.IsControllable)).ToArray(),
            Enumerable.Range(0, transitionsNum).Select(i => new AutomatonDraftValidator.TransitionDraft(
                transitions[i, 0], transitions[i, 2], string.IsNullOrWhiteSpace(transitions[i, 1]) ? Array.Empty<string>() : new[] { transitions[i, 1] })).ToArray(), initial);
        var result = Validator.ValidateAndCreate(draft, ExistingAutomatonNames);
        errors.AddRange(result.Errors);
        if (result.IsValid && !OnSuccess(result.Automaton!))
            errors.Add("The automaton conflicts with the current workspace and was not added.");
    }

}
