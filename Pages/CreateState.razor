@using global::UltraDES

<div class="compact-form">
    <div class="field">
        <label class="label" for="state-names">State names</label>
        <input type="text" class="input" id="state-names" @bind="name" @onkeyup="HandleKey" aria-describedby="state-help" autocomplete="off" autofocus>
        <p class="help" id="state-help">Separate multiple names with semicolons, for example: idle; working; done.</p>
    </div>
    <div class="field">
        <label class="checkbox"><input type="checkbox" @bind="opt"> Mark all created states</label>
    </div>
    @if (!string.IsNullOrWhiteSpace(error)) { <p class="help is-danger" role="alert">@error</p> }
    <div class="buttons">
        <button type="button" class="button is-primary" @onclick="Create">Create states</button>
        <button type="button" class="button" @onclick="OnCancel">Cancel</button>
    </div>
</div>

@code {
    [Parameter] public Action<AbstractState> OnSuccess { get; set; }
    [Parameter] public Action OnCancel { get; set; }

    private string name = "";
    private bool opt = false;
    private string error = "";

    private void Create()
    {
        error = "";
        var subStates = name.Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.Ordinal).ToArray();
        if (subStates.Length == 0)
        {
            error = "Enter at least one state name.";
            return;
        }
        foreach(var sub in subStates)
        {
            var q = new State(sub, opt ? Marking.Marked : Marking.Unmarked);
            OnSuccess(q);
        }
    }

    private void HandleKey(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") Create();
    }

}
