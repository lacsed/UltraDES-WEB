@using global::UltraDES
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="visual-automaton-editor">
    <div class="visual-editor-toolbar">
        <div class="field">
            <label class="label" for="visual-automaton-name">Automaton name</label>
            <input id="visual-automaton-name" class="input" @bind="automatonName" />
        </div>
        <form class="visual-event-form" @onsubmit="AddEvent" @onsubmit:preventDefault>
            <div class="field">
                <label class="label" for="visual-event-name">New event</label>
                <input id="visual-event-name" class="input" @bind="eventName" placeholder="e.g. start" />
            </div>
            <div class="field">
                <label class="label" for="visual-event-kind">Controllability</label>
                <div class="select is-fullwidth">
                    <select id="visual-event-kind" @bind="eventControllable">
                        <option value="true">Controllable</option>
                        <option value="false">Uncontrollable</option>
                    </select>
                </div>
            </div>
            <button class="button is-info" type="submit">Add event</button>
        </form>
        <div class="visual-event-list" aria-label="Draft events">
            @foreach (var draftEvent in draftEvents)
            {
                <span class="tag @(draftEvent.Controllable ? "is-success" : "is-warning")">
                    <i class="fas @(draftEvent.Controllable ? "fa-lock-open" : "fa-lock")" aria-hidden="true"></i>&nbsp;
                    @draftEvent.Name (@(draftEvent.Controllable ? "controllable" : "uncontrollable"))
                </span>
            }
        </div>
    </div>

    <p class="help visual-editor-help">
        Click or double-click empty space to add a state. Drag from a state to another state (or itself) to add a transition.
        Click a state to select it; use the toolbar buttons to mark it or make it initial. Drag states and square transition handles to arrange the diagram.
        Press Delete/Backspace to remove the selection and Escape to cancel an action.
    </p>
    <div class="visual-editor-actions" role="toolbar" aria-label="Selected state actions">
        <button class="button" type="button" @onclick="ToggleMarked">Toggle marked</button>
        <button class="button" type="button" @onclick="SetInitial">Set initial</button>
        <span class="visual-editor-legend"><i class="fas fa-lock-open" aria-hidden="true"></i> Controllable &nbsp; <i class="fas fa-lock" aria-hidden="true"></i> Uncontrollable</span>
    </div>

    <div @ref="editorHost" class="visual-editor-canvas" tabindex="0" role="application" aria-label="Visual automaton canvas"></div>
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="notification is-danger" role="alert">@error</div>
    }
    <div class="buttons mt-4">
        <button class="button is-success" type="button" @onclick="Save">Create Automaton</button>
        <button class="button is-danger" type="button" @onclick="OnCancel">Cancel</button>
    </div>
</div>

@code {
    [Parameter] public Action<DeterministicFiniteAutomaton> OnSuccess { get; set; }
    [Parameter] public Action OnCancel { get; set; }

    // These DTOs deliberately keep the mutable visual draft separate from UltraDES.
    public sealed class DraftState { public string Id { get; set; } public string Name { get; set; } public bool Marked { get; set; } public double X { get; set; } public double Y { get; set; } }
    public sealed class DraftEvent { public string Id { get; set; } public string Name { get; set; } public bool Controllable { get; set; } }
    public sealed class DraftTransition { public string Id { get; set; } public string SourceId { get; set; } public string TargetId { get; set; } public string[] EventNames { get; set; } public double ControlX { get; set; } public double ControlY { get; set; } }
    public sealed class AutomatonDraft { public DraftState[] States { get; set; } public DraftEvent[] Events { get; set; } public DraftTransition[] Transitions { get; set; } public string InitialStateId { get; set; } }

    private ElementReference editorHost;
    private IJSObjectReference module;
    private IJSObjectReference editor;
    private string automatonName = "";
    private string eventName = "";
    private string eventControllable = "true";
    private string error = "";
    private readonly List<DraftEvent> draftEvents = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/automaton-editor.js");
        editor = await module.InvokeAsync<IJSObjectReference>("createAutomatonEditor", editorHost);
    }

    private async Task AddEvent()
    {
        error = "";
        var name = eventName.Trim();
        if (string.IsNullOrWhiteSpace(name)) { error = "Event name cannot be blank."; return; }
        if (name.Contains(',')) { error = "An event name cannot contain a comma."; return; }
        if (draftEvents.Any(e => string.Equals(e.Name, name, StringComparison.Ordinal))) { error = "Event names must be unique."; return; }
        var item = new DraftEvent { Id = Guid.NewGuid().ToString("N"), Name = name, Controllable = eventControllable == "true" };
        draftEvents.Add(item);
        eventName = "";
        await editor.InvokeVoidAsync("addEvent", item);
    }

    private async Task InvokeEditor(string operation)
    {
        if (editor is not null) await editor.InvokeVoidAsync(operation);
    }

    private Task ToggleMarked() => InvokeEditor("toggleMarked");
    private Task SetInitial() => InvokeEditor("setInitial");

    private async Task Save()
    {
        error = "";
        if (string.IsNullOrWhiteSpace(automatonName)) { error = "Automaton name cannot be blank."; return; }
        var draft = await editor.InvokeAsync<AutomatonDraft>("getDraft");
        if (draft.States.Length == 0) { error = "Add at least one state."; return; }
        if (string.IsNullOrEmpty(draft.InitialStateId)) { error = "Select an initial state."; return; }

        var states = draft.States.ToDictionary(q => q.Id, q => (AbstractState)new State(q.Name, q.Marked ? Marking.Marked : Marking.Unmarked));
        var events = draft.Events.ToDictionary(e => e.Name, e => (AbstractEvent)new Event(e.Name, e.Controllable ? Controllability.Controllable : Controllability.Uncontrollable));
        var transitions = draft.Transitions.SelectMany(edge => edge.EventNames.Select(name => new Transition(states[edge.SourceId], events[name], states[edge.TargetId]))).ToArray();
        OnSuccess(new DeterministicFiniteAutomaton(transitions, states[draft.InitialStateId], automatonName.Trim()));
    }

    public async ValueTask DisposeAsync()
    {
        if (editor is not null)
        {
            try
            {
                await editor.InvokeVoidAsync("dispose");
                await editor.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser can disconnect while the modal is being removed.
            }
        }
        if (module is not null) await module.DisposeAsync();
    }
}
