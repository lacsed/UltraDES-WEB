@using global::UltraDES
@implements IAsyncDisposable
@inject AutomatonDraftValidator Validator
@inject IJSRuntime JS

<div class="visual-automaton-editor">
    @if (!LayoutOnly)
    {
    <div class="visual-editor-toolbar">
        <div class="field">
            <label class="label" for="visual-automaton-name">Automaton name</label>
            <input id="visual-automaton-name" class="input" @bind="automatonName" />
        </div>
    </div>
    }

    <p class="help visual-editor-help">
        @if (LayoutOnly) { <text>Drag states and square transition handles to arrange the diagram. Use the mouse wheel to zoom and drag empty space to pan. The automaton structure is read-only.</text> }
        else { <text>Double-click: add/mark a state. Click and type to rename. Shift+drag: transition. Click and type comma-separated events. Double-click an event badge: toggle control. Shift+double-click a state: set initial.</text> }
    </p>

    <div @ref="editorHost" class="visual-editor-canvas" tabindex="0" role="application" aria-label="Visual automaton canvas"></div>
    @if (errors.Count > 0)
    {
        <div class="notification is-danger" role="alert"><strong>Please correct the following:</strong><ul>@foreach (var message in errors) { <li>@message</li> }</ul></div>
    }
    <div class="buttons mt-4">
        <button class="button is-success" type="button" @onclick="Save">@(LayoutOnly ? "Save Layout" : "Create Automaton")</button>
        <button class="button is-danger" type="button" @onclick="OnCancel">Cancel</button>
    </div>
</div>

@code {
    [Parameter] public Func<DeterministicFiniteAutomaton, bool> OnSuccess { get; set; }
    [Parameter] public Action OnCancel { get; set; }
    [Parameter] public IEnumerable<string> ExistingAutomatonNames { get; set; } = Array.Empty<string>();
    [Parameter] public DeterministicFiniteAutomaton Automaton { get; set; }
    [Parameter] public AutomatonLayoutData Layout { get; set; }
    [Parameter] public Func<AutomatonLayoutData, Task> OnLayoutSaved { get; set; }
    private bool LayoutOnly => Automaton is not null;

    // These DTOs deliberately keep the mutable visual draft separate from UltraDES.
    public sealed class DraftState { public string Id { get; set; } public string Name { get; set; } public bool Marked { get; set; } public double X { get; set; } public double Y { get; set; } }
    public sealed class DraftEvent { public string Id { get; set; } public string Name { get; set; } public bool Controllable { get; set; } }
    public sealed class DraftTransition { public string Id { get; set; } public string SourceId { get; set; } public string TargetId { get; set; } public string[] EventNames { get; set; } public double ControlX { get; set; } public double ControlY { get; set; } }
    public sealed class AutomatonDraft { public DraftState[] States { get; set; } public DraftEvent[] Events { get; set; } public DraftTransition[] Transitions { get; set; } public string InitialStateId { get; set; } }

    private ElementReference editorHost;
    private IJSObjectReference module;
    private IJSObjectReference editor;
    private string automatonName = "";
    private readonly List<string> errors = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/automaton-editor.js");
        editor = await module.InvokeAsync<IJSObjectReference>("createAutomatonEditor", editorHost, LayoutOnly);
        if (LayoutOnly)
        {
            automatonName = Automaton.Name;
            var states = Automaton.States.Select(q => new DraftState { Id = q.ToString(), Name = q.ToString(), Marked = q.IsMarked }).ToArray();
            var events = Automaton.Events.Select(e => new DraftEvent { Id = e.ToString(), Name = e.ToString(), Controllable = e.IsControllable }).ToArray();
            var transitions = Automaton.Transitions.GroupBy(t => (Source: t.Origin.ToString(), Target: t.Destination.ToString()))
                .Select((group, index) => new DraftTransition { Id = $"transition-{index}", SourceId = group.Key.Source, TargetId = group.Key.Target,
                    EventNames = group.Select(t => t.Trigger.ToString()).OrderBy(x => x).ToArray() }).ToArray();
            await editor.InvokeVoidAsync("loadAutomaton", new AutomatonDraft { States = states, Events = events, Transitions = transitions,
                InitialStateId = Automaton.InitialState.ToString() }, Layout);
        }
    }

    private async Task Save()
    {
        errors.Clear();
        if (LayoutOnly)
        {
            var layout = await editor.InvokeAsync<AutomatonLayoutData>("getLayout");
            if (OnLayoutSaved is not null) await OnLayoutSaved(layout);
            return;
        }
        var draft = await editor.InvokeAsync<AutomatonDraft>("getDraft");
        var validationDraft = new AutomatonDraftValidator.Draft(automatonName,
            draft.States.Select(q => new AutomatonDraftValidator.StateDraft(q.Id, q.Name, q.Marked)).ToArray(),
            draft.Events.Select(e => new AutomatonDraftValidator.EventDraft(e.Id, e.Name, e.Controllable)).ToArray(),
            draft.Transitions.Select(t => new AutomatonDraftValidator.TransitionDraft(t.SourceId, t.TargetId,
                t.EventNames.Select(name => draft.Events.FirstOrDefault(e => e.Name == name)?.Id ?? name).ToArray())).ToArray(), draft.InitialStateId);
        var result = Validator.ValidateAndCreate(validationDraft, ExistingAutomatonNames);
        errors.AddRange(result.Errors);
        if (result.IsValid && !OnSuccess(result.Automaton!))
            errors.Add("The automaton conflicts with the current workspace and was not added.");
    }

    public async ValueTask DisposeAsync()
    {
        if (editor is not null)
        {
            try
            {
                await editor.InvokeVoidAsync("dispose");
                await editor.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser can disconnect while the modal is being removed.
            }
        }
        if (module is not null) await module.DisposeAsync();
    }
}
