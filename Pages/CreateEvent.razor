@using global::UltraDES

<div class="compact-form">
    <div class="field">
        <label class="label" for="event-names">Event names</label>
        <input type="text" class="input" id="event-names" @bind="name" @onkeyup="HandleKey" aria-describedby="event-help" autocomplete="off" autofocus>
        <p class="help" id="event-help">Separate multiple names with semicolons, for example: start; stop; reset.</p>
    </div>
    <div class="field">
        <label class="checkbox"><input type="checkbox" @bind="opt"> Mark all created events as uncontrollable</label>
    </div>
    @if (!string.IsNullOrWhiteSpace(error)) { <p class="help is-danger" role="alert">@error</p> }
    <div class="buttons">
        <button type="button" class="button is-primary" @onclick="Create">Create events</button>
        <button type="button" class="button" @onclick="OnCancel">Cancel</button>
    </div>
</div>

@code {
    [Parameter] public Action<AbstractEvent> OnSuccess { get; set; }
    [Parameter] public Action OnCancel { get; set; }

    private string name = "";
    private bool opt = false;
    private string error = "";

    private void Create()
    {
        error = "";
        var subEvents = name.Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.Ordinal).ToArray();
        if (subEvents.Length == 0)
        {
            error = "Enter at least one event name.";
            return;
        }
        foreach(var sub in subEvents)
        {
            var e = new Event(sub, !opt ? Controllability.Controllable : Controllability.Uncontrollable);
            OnSuccess(e);
        }
    }

    private void HandleKey(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") Create();
    }

}
