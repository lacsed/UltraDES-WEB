@page "/"
@using global::UltraDES
@using System.Threading
@inject IJSRuntime JsRuntime;
@inject WorkspaceStorage WorkspaceStorage;
@inject AutomatonLayoutService AutomatonLayoutService;

<nav class="app-navbar grid-header" role="navigation" aria-label="main navigation">
    <div class="navbar-brand">
        <a class="navbar-item app-brand" href="https://github.com/lacsed/UltraDES">
            <img src="/UltraDES/img/logo.png" alt="UltraDES" width="112" height="50">
            <span class="brand-copy"><strong>UltraDES</strong><small>Discrete Event Systems</small></span>
        </a>
        <button type="button" class="mobile-menu-button" aria-label="Toggle navigation" aria-expanded="@mobileMenuOpen" @onclick="() => mobileMenuOpen = !mobileMenuOpen">
            <i class="fas @(mobileMenuOpen ? "fa-times" : "fa-bars")"></i>
        </button>
    </div>
    <div class="navbar-end app-navigation">
        <div class="dropdown is-hoverable is-hidden-mobile">
            <button class="button" aria-haspopup="true" aria-controls="create">
                <span>Create <i class="fas fa-angle-down"></i></span>
            </button>
            <div class="dropdown-menu" id="create" role="menu">
                <div class="dropdown-content">
                    <a @onclick="ev => page = Page.CreateState" class="is-mobile dropdown-item">Create State</a>
                    <a @onclick="ev => page = Page.CreateEvent" class="is-mobile dropdown-item">Create Event</a>
                    <a @onclick="ev => page = Page.CreateAutomaton" class="is-mobile dropdown-item">Create Automaton</a>
                    <a @onclick="ev => page = Page.CreateVisualAutomaton" class="is-mobile dropdown-item">Create Visual Automaton</a>
                </div>
            </div>
        </div>
        <div class="dropdown is-hoverable is-hidden-mobile">
            <button class="button" aria-haspopup="true" aria-controls="operations">
                <span>Operations <i class="fas fa-angle-down"></i></span>
            </button>
            <div class="dropdown-menu" id="operations" role="menu">
                <div class="dropdown-content">
                    <a @onclick="ev => page = Page.CreateAutomaton" class="is-mobile dropdown-item">Create Automaton</a>
                    <a @onclick="ev => page = Page.UnaryOperations" class="is-mobile dropdown-item">Apply Unary Operation</a>
                    <a @onclick="ev => page = Page.BinaryOperations" class="is-mobile dropdown-item">Apply Binary Operation</a>
                    <a @onclick="ev => page = Page.CreateSupervisor" class="is-mobile dropdown-item">Supervisor Synthesis</a>
                    <hr class="dropdown-divider">
                    <label class="is-mobile dropdown-item"><input type="file" style="display: none" id="loadjson" @onchange="@(() => LoadJsonAutomaton("loadjson"))"><a>Upload Json Automaton</a></label>
                    <label class="is-mobile dropdown-item"><input type="file" style="display: none" id="loadwmod" @onchange="@(() => LoadWmodAutomaton("loadwmod"))"><a>Upload Wmod Automaton</a></label>
                    <label class="is-mobile dropdown-item"><input @onclick="ev => page = Page.ExportWmod" style="display: none"><a>Export Wmod</a></label>
                    <label class="is-mobile dropdown-item"><input type="file" style="display: none" id="loadads" @onchange="@(() => LoadAdsAutomaton("loadads"))"><a>Upload Ads Automaton</a></label>
                    <label class="is-mobile dropdown-item"><input type="file" style="display: none" id="loadxml" @onchange="@(() => LoadXmlAutomaton("loadxml"))"><a>Upload XML Automaton</a></label>
                </div>
            </div>
        </div>
        <div class="dropdown is-hoverable is-hidden-mobile">
            <button class="button" aria-haspopup="true" aria-controls="examples">
                <span>Examples <i class="fas fa-angle-down"></i></span>
            </button>
            <div class="dropdown-menu" id="examples" role="menu">
                <div class="dropdown-content">
                    <a @onclick="LoadSmallFactory" class="is-mobile dropdown-item">Small Factory</a>
                    <a @onclick="LoadFlexibleManufacturingSystem" class="is-mobile dropdown-item">FMS</a>
                </div>
            </div>
        </div>
        <div class="dropdown mobile-navigation @(mobileMenuOpen ? "is-active" : "")">
            <button class="button" aria-haspopup="true" aria-controls="mobile">
                <span>Options <i class="fas fa-angle-down"></i></span>
            </button>
            <div class="dropdown-menu" id="mobile" role="menu">
                <div class="dropdown-content">
                    <p class="menu-label dropdown-item">Create</p>
                    <a @onclick="ev => page = Page.CreateState" class="is-mobile dropdown-item">Create State</a>
                    <a @onclick="ev => page = Page.CreateEvent" class="is-mobile dropdown-item">Create Event</a>
                    <a @onclick="ev => page = Page.CreateAutomaton" class="is-mobile dropdown-item">Create Automaton</a>
                    <a @onclick="ev => page = Page.CreateVisualAutomaton" class="is-mobile dropdown-item">Create Visual Automaton</a>
                    <hr class="dropdown-divider">
                    <p class="menu-label dropdown-item">Operations</p>
                    <a @onclick="ev => page = Page.CreateAutomaton" class="is-mobile dropdown-item">Create Automaton</a>
                    <a @onclick="ev => page = Page.UnaryOperations" class="is-mobile dropdown-item">Apply Unary Operation</a>
                    <a @onclick="ev => page = Page.BinaryOperations" class="is-mobile dropdown-item">Apply Binary Operation</a>
                    <a @onclick="ev => page = Page.CreateSupervisor" class="is-mobile dropdown-item">Supervisor Synthesis</a>
                    <hr class="dropdown-divider">
                    <p class="menu-label dropdown-item">Import</p>
                    <label class="is-mobile dropdown-item"><input type="file" style="display: none" id="loadjson_m" @onchange="@(() => LoadJsonAutomaton("loadjson_m"))"><a>Upload Json Automaton</a></label>
                    <label class="is-mobile dropdown-item"><input type="file" style="display: none" id="loadwmod_m" @onchange="@(() => LoadWmodAutomaton("loadwmod_m"))"><a>Upload Wmod Automaton</a></label>
                    <label class="is-mobile dropdown-item"><input style="display: none" @onclick="ev => page = Page.ExportWmod"><a>Export Wmod Automaton</a></label>
                    <label class="is-mobile dropdown-item"><input type="file" style="display: none" id="loadads_m" @onchange="@(() => LoadAdsAutomaton("loadads_m"))"><a>Upload Ads Automaton</a></label>
                    <label class="is-mobile dropdown-item"><input type="file" style="display: none" id="loadxml_m" @onchange="@(() => LoadXmlAutomaton("loadxml_m"))"><a>Upload XML Automaton</a></label>
                    <hr class="dropdown-divider">
                    <p class="menu-label dropdown-item">Examples</p>
                    <a @onclick="LoadSmallFactory" class="is-mobile dropdown-item">Small Factory</a>
                    <a @onclick="LoadFlexibleManufacturingSystem" class="is-mobile dropdown-item">FMS</a>
                </div>
            </div>
        </div>
    </div>
</nav>

<main class="grid-content app-main">
    @if (!string.IsNullOrWhiteSpace(workspaceError))
    {
        <div class="notification is-danger" role="alert">@workspaceError</div>
    }
    @if (layoutGenerating)
    {
        <div class="notification is-info" role="status"><strong>Creating visual layout…</strong> @layoutProgress
            <button class="button is-small ml-3" type="button" @onclick="CancelVisualLayout">Cancel</button>
        </div>
    }
    <aside class="workspace-sidebar">
        <div class="workspace-heading">
            <div><span class="eyebrow">Current project</span><h1>Workspace</h1></div>
            <span class="workspace-total">@(states.Count + events.Count + automata.Count)</span>
        </div>
        <p class="menu-label">States <span class="item-count">@states.Count</span><a class="content-button" @onclick="() => ShowStates = !ShowStates">@((ShowStates) ? "Hide": "Show")</a></p>
        <ul class="menu-list">
            @if (ShowStates)
            {
                @foreach (var q in states)
                {
                    <li class="level is-mobile">
                        <div class="level-left">State @q.Key</div>
                        <div class="level-right">
                            @if (q.Value.IsMarked)
                            {
                                <span class="icon" title="Marked">
                                    <span class="fa-stack" style="font-size: 0.5em;">
                                        <i class="far fa-circle fa-stack-2x has-text-black" style="vertical-align: middle;"></i>
                                        <i class="far fa-circle fa-stack-1x has-text-black" style="vertical-align: middle;"></i>
                                    </span>
                                </span>
                            }
                            else
                            {
                                <span class="icon" title="Unmarked">
                                    <i class="far fa-circle has-text-black"></i>
                                </span>
                            }
                            <a @onclick="() => RemoveState(q.Key)" title="Delete" class="px-2" style="all: unset"><i class="fas fa-trash has-text-danger"></i></a>
                        </div>

                    </li>
                }
            }
        </ul>

        <p class="menu-label">Events <span class="item-count">@events.Count</span><a class="content-button" @onclick="() => ShowEvents = !ShowEvents">@((ShowEvents) ? "Hide": "Show")</a></p>
        <ul class="menu-list">

            @if (ShowEvents)
            {
                @foreach (var e in events)
                {
                    <li class="level is-mobile">
                        <div class="level-left">Event @e.Key</div>
                        <div class="level-right" id="createdAutomatons">
                            @if (!e.Value.IsControllable)
                            {
                                <span class="icon" title="Uncontrollable">
                                    <i class="fas fa-long-arrow-alt-right has-text-black"></i>
                                </span>
                            }
                            else
                            {
                                <span class="icon" title="Controllable">
                                    <span class="fa-stack" style="font-size: 0.5em;">
                                        <i class="fas fa-long-arrow-alt-right fa-stack-2x has-text-black" style="vertical-align: middle;"></i>
                                        <i class="fas fa-plus fa-stack-1x has-text-black"></i>
                                    </span>
                                </span>
                            }
                            <a @onclick="() => RemoveEvent(e.Key)" title="Delete" class="px-2" style="all: unset"><i class="fas fa-trash has-text-danger"></i></a>
                        </div>
                    </li>
                }
            }

        </ul>


        <p class="menu-label">Automata <span class="item-count">@automata.Count</span><a class="content-button" @onclick="() => ShowAutomata = !ShowAutomata">@((ShowAutomata) ? "Hide": "Show")</a></p>
        <ul class="menu-list">
            @if (ShowAutomata)
            {
                @foreach (var G in automata)
                {
                    <li class="level is-mobile">

                        <div class="dropdown is-hoverable" style="width: 100%">
                            <div aria-haspopup="true" aria-controls="@(G.Key)" style="width: 100%">
                                <div class="level is-mobile">
                                    <div class="level-left" title="@(G.Key)"><span>Aut. @(G.Key.MaxLength(20))</span></div>
                                    <div class="level-right"><span><i class="fas fa-angle-down"></i></span></div>
                                </div>
                            </div>

                            <div class="dropdown-menu" id="@(G.Key)">
                                <div class="dropdown-content">
                                    <a @onclick="() => SummaryAutomaton(G.Value)">
                                        <div class="level is-mobile">
                                            <div class="level-left"><span>Summary</span></div>
                                            <div class="level-right"><span><i class="fas fa-list has-text-black"></i></span></div>
                                        </div>
                                    </a>
                                    <a @onclick="() => ShowAutomaton(G.Value)" aria-disabled="@renderingAutomaton">
                                        <div class="level is-mobile">
                                            <div class="level-left"><span>Show</span></div>
                                            <div class="level-right"><span><i class="fas fa-project-diagram has-text-info"></i></span></div>
                                        </div>
                                    </a>
                                    <a @onclick="() => OpenVisualLayout(G.Value)" class="@(CanOpenVisualLayout(G.Value) ? "" : "has-text-grey")"
                                       aria-disabled="@(!CanOpenVisualLayout(G.Value))" title="@VisualLayoutTitle(G.Value)">
                                        <div class="level is-mobile">
                                            <div class="level-left"><span>Open Visual Layout</span></div>
                                            <div class="level-right"><span><i class="fas fa-edit has-text-info"></i></span></div>
                                        </div>
                                    </a>
                                    <a @onclick="() => VerifyOpacityAutomaton(G.Value)">
                                        <div class="level is-mobile">
                                            <div class="level-left"><span>Opacity/Diagnostic</span></div>
                                            <div class="level-right"><span><i class="fas fa-eye-slash has-text-info"></i></span></div>
                                        </div>
                                    </a>
                                    <a @onclick="() => SaveAutomaton(G.Value)">
                                        <div class="level is-mobile">
                                            <div class="level-left"><span>Download</span></div>
                                            <div class="level-right"><span><i class="fas fa-save has-text-info"></i></span></div>
                                        </div>
                                    </a>
                                    <a @onclick="() => RemoveAutomaton(G.Key)">
                                        <div class="level is-mobile">
                                            <div class="level-left"><span>Delete</span></div>
                                            <div class="level-right"><span><i class="fas fa-trash has-text-danger"></i></span></div>
                                        </div>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </li>
                }
            }
        </ul>
    </aside>

    <section class="workspace-content">
        @switch (page)
        {
            case Page.CreateState:
                <Modal Title="Create a State" OnClose="@Clear"><CreateState OnSuccess="q => AddState(q)" OnCancel="@Clear"></CreateState></Modal>
                break;
            case Page.CreateEvent:
                <Modal Title="Create an Event" OnClose="@Clear"><CreateEvent OnSuccess="e => AddEvent(e)" OnCancel="@Clear"></CreateEvent></Modal>
                break;
            case Page.CreateAutomaton:
                <Modal Title="Create an Automaton" OnClose="@Clear"><CreateAutomaton OnSuccess="G => AddAutomaton(new[]{G})" OnCancel="@Clear" Events="events" States="states" ExistingAutomatonNames="automata.Keys"></CreateAutomaton></Modal>
                break;
            case Page.CreateVisualAutomaton:
                <Modal Title="Create a Visual Automaton" OnClose="@Clear"><VisualAutomatonEditor OnSuccess="G => AddAutomaton(new[]{G})" OnCancel="@Clear" ExistingAutomatonNames="automata.Keys" /></Modal>
                break;
            case Page.ShowAutomaton:
                <Modal Title="@automaton.Name" OnClose="@CloseAutomaton">
                    <GraphViz Automaton="@automaton" StateCount="@automatonStateCount" LargeAutomatonConfirmed="@largeAutomatonConfirmed"
                              OnCancel="@CloseAutomaton" OnRenderingChanged="SetRenderingState"></GraphViz>
                </Modal>
                break;
            case Page.EditVisualLayout:
                <Modal Title="@(activeLayout is null ? $"Create Visual Layout — {automaton.Name}" : $"Open Visual Layout — {automaton.Name}")" OnClose="@Clear">
                    <VisualAutomatonEditor Automaton="automaton" Layout="activeLayout" OnLayoutSaved="SaveVisualLayout" OnCancel="@Clear" />
                </Modal>
                break;
            case Page.VerifyOpacityAutomaton:
                <Modal Title="@automaton.Name" OnClose="@Clear">
                    <VerifyOpacity Automaton="@automaton" OnCancel="@Clear" OnSuccess="G => AddAutomaton(new[]{G})"></VerifyOpacity>
                </Modal>
                break;
            case Page.AutomatonSummary:
                <Modal Title="@automaton.Name" OnClose="@Clear"><AutomatonSummary Automaton="@automaton" OnCancel="@Clear"></AutomatonSummary></Modal>
                break;
            case Page.CreateSupervisor:
                <Modal Title="Create a Supervisor" OnClose="@Clear"><CreateSupervisor Automata="automata" OnSuccess="S => AddAutomaton(S) " OnCancel="@Clear"></CreateSupervisor></Modal>
                break;
            case Page.BinaryOperations:
                <Modal Title="Apply a Binary Operation" OnClose="@Clear"><ApplyBinaryOperation Automata="automata" OnSuccess="G => AddAutomaton(new[]{G}) " OnCancel="@Clear"></ApplyBinaryOperation></Modal>
                break;
            case Page.UnaryOperations:
                <Modal Title="Apply an unary Operation" OnClose="@Clear"><ApplyUnaryOperation Automata="automata" OnSuccess="G => AddAutomaton(new[]{G}) " OnCancel="@Clear"></ApplyUnaryOperation></Modal>
                break;
            case Page.ExportWmod:
                <Modal Title="Export Wmod" OnClose="@Clear"><ExportWmod Automata="automata" OnSuccess="@Clear" OnCancel="@Clear"></ExportWmod></Modal>
                break;
            case Page.Empty:
            default:
                <div class="welcome-panel">
                    <div class="welcome-copy">
                        <span class="eyebrow">Model, analyze and control</span>
                        <h2>Build discrete event systems with clarity.</h2>
                        <p>Create your workspace visually or start with individual states and events. Your work is saved locally as you go.</p>
                        <div class="welcome-actions">
                            <button class="button is-primary" @onclick="ev => page = Page.CreateVisualAutomaton"><i class="fas fa-project-diagram"></i><span>New visual automaton</span></button>
                            <button class="button is-light" @onclick="ev => page = Page.CreateAutomaton"><i class="fas fa-plus"></i><span>Create manually</span></button>
                        </div>
                    </div>
                    <div class="welcome-graphic" aria-hidden="true">
                        <span class="node node-a">q0</span><span class="connector connector-a"></span>
                        <span class="node node-b">q1</span><span class="connector connector-b"></span>
                        <span class="node node-c">q2</span>
                    </div>
                    <div class="quick-grid">
                        <button @onclick="ev => page = Page.CreateState"><i class="far fa-circle"></i><span><strong>Create state</strong><small>Add marked or unmarked states</small></span></button>
                        <button @onclick="ev => page = Page.CreateEvent"><i class="fas fa-long-arrow-alt-right"></i><span><strong>Create event</strong><small>Define system events</small></span></button>
                        <button @onclick="LoadSmallFactory"><i class="fas fa-industry"></i><span><strong>Try an example</strong><small>Load the Small Factory</small></span></button>
                    </div>
                    @if (automata.Count > 0)
                    {
                        <div class="automata-gallery">
                            <div class="gallery-heading">
                                <div><span class="eyebrow">Workspace</span><h3>Your automata</h3></div>
                                <span>@automata.Count @(automata.Count == 1 ? "automaton" : "automata")</span>
                            </div>
                            <div class="automata-grid">
                                @foreach (var item in automata)
                                {
                                    var stateCount = item.Value.States.Count();
                                    var transitionCount = item.Value.Transitions.Count();
                                    var hasLayout = layouts.ContainsKey(automatonIds[item.Key]);
                                    <article class="automaton-card">
                                        <button class="automaton-preview" type="button" @onclick="() => OpenVisualLayout(item.Value)" disabled="@(!CanOpenVisualLayout(item.Value))" aria-label="Open visual layout for @item.Key">
                                            <span class="mini-node mini-node-one"></span><span class="mini-edge"></span><span class="mini-node mini-node-two"></span>
                                            <span class="layout-badge"><i class="fas @(hasLayout ? "fa-pen" : "fa-magic")"></i> @(hasLayout ? "Saved layout" : "Auto layout")</span>
                                        </button>
                                        <div class="automaton-card-body">
                                            <h4 title="@item.Key">@item.Key</h4>
                                            <p>@stateCount states · @transitionCount transitions</p>
                                            <div class="card-actions">
                                                <button type="button" title="Open visual layout" @onclick="() => OpenVisualLayout(item.Value)" disabled="@(!CanOpenVisualLayout(item.Value))"><i class="fas fa-edit"></i></button>
                                                <button type="button" title="Summary" @onclick="() => SummaryAutomaton(item.Value)"><i class="fas fa-list"></i></button>
                                                <button type="button" title="Show graph" @onclick="() => ShowAutomaton(item.Value)"><i class="fas fa-project-diagram"></i></button>
                                                <button type="button" class="danger" title="Delete" @onclick="() => RemoveAutomaton(item.Key)"><i class="fas fa-trash"></i></button>
                                            </div>
                                        </div>
                                    </article>
                                }
                            </div>
                        </div>
                    }
                </div>
                break;
        }
    </section>
</main>

@if (confirmationAutomaton is not null)
{
    <ConfirmationModal Title="Render large automaton?" ConfirmText="Render anyway" CancelText="Cancel"
                       Disabled="@confirmationSubmitting" OnConfirm="ConfirmLargeAutomaton" OnCancel="CancelLargeAutomaton">
        <p>This automaton has exactly <strong>@confirmationStateCount states</strong>. Rendering may take a long time. Do you want to continue?</p>
    </ConfirmationModal>
}

<footer class="app-footer">
    <span><strong>UltraDES</strong> · Open-source tools for discrete event systems</span>
    <span>Developed by <a href="https://lacsed.eng.ufmg.br">LACSED</a> at <a href="https://www.ufmg.br">UFMG</a></span>
</footer>

@code
{
    enum Page
    {
        Empty,
        CreateState,
        CreateEvent,
        CreateAutomaton,
        CreateVisualAutomaton,
        ShowAutomaton,
        EditVisualLayout,
        VerifyOpacityAutomaton,
        AutomatonSummary,
        CreateSupervisor,
        BinaryOperations,
        UnaryOperations,
        ExportWmod
    }

    private readonly Dictionary<string, AbstractState> states = new Dictionary<string, AbstractState>();
    private readonly Dictionary<string, AbstractEvent> events = new Dictionary<string, AbstractEvent>();
    private readonly Dictionary<string, DeterministicFiniteAutomaton> automata = new Dictionary<string, DeterministicFiniteAutomaton>();
    private readonly Dictionary<string, string> automatonIds = new();
    private readonly Dictionary<string, AutomatonLayoutData> layouts = new();
    private Page page = Page.Empty;
    private DeterministicFiniteAutomaton automaton = null;
    private AutomatonLayoutData activeLayout;
    private bool ShowStates = false;
    private bool ShowEvents = false;
    private bool ShowAutomata = true;
    private bool workspaceLoaded;
    private string workspaceError = "";
    private DeterministicFiniteAutomaton confirmationAutomaton;
    private int confirmationStateCount;
    private int automatonStateCount;
    private bool largeAutomatonConfirmed;
    private bool confirmationSubmitting;
    private bool renderingAutomaton;
    private bool layoutGenerating;
    private bool mobileMenuOpen;
    private string layoutProgress = "";
    private CancellationTokenSource layoutCancellation;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var saved = await WorkspaceStorage.LoadAsync();
        if (saved is not null)
        {
            foreach (var state in saved.States)
                states.TryAdd(state.Alias, new State(state.Alias, state.Marking));
            foreach (var @event in saved.Events)
                events.TryAdd(@event.Alias, new Event(@event.Alias, @event.Controllability));
            foreach (var stored in saved.Automata)
            {
                try
                {
                    var loaded = DeterministicFiniteAutomaton.FromJsonString(stored.Json).Single();
                    if (AddAutomaton(loaded, false, stored.Id) && stored.Layout is not null)
                        layouts[stored.Id] = stored.Layout;
                }
                catch
                {
                    // Preserve the remaining workspace if a single automaton is invalid.
                }
            }
        }

        workspaceLoaded = true;
        StateHasChanged();
    }

    private void PersistWorkspace()
    {
        if (workspaceLoaded)
            _ = WorkspaceStorage.SaveAsync(states.Values, events.Values, automata.Select(pair =>
            {
                var id = automatonIds[pair.Key];
                layouts.TryGetValue(id, out var layout);
                return new StoredAutomaton(id, DeterministicFiniteAutomaton.ToJsonString(pair.Value), layout);
            }));
    }
    private void Clear()
    {
        page = Page.Empty;
        StateHasChanged();
    }

    private void AddState(AbstractState q)
    {
        page = Page.Empty;

        Console.WriteLine(q);
        if (!states.ContainsKey(q.ToString()))
            states.Add(q.ToString(), q);

        PersistWorkspace();
        StateHasChanged();
    }

    private async void RemoveState(string state)
    {
        if (!await JsRuntime.Confirm($"Delete State {state}?")) return;
        states.Remove(state);

        PersistWorkspace();
        StateHasChanged();
    }

    private void AddEvent(AbstractEvent e)
    {
        page = Page.Empty;

        Console.WriteLine(e);
        if (!events.ContainsKey(e.ToString())) events.Add(e.ToString(), e);

        PersistWorkspace();
        StateHasChanged();
    }

    private async void RemoveEvent(string ev)
    {
        if (!await JsRuntime.Confirm($"Delete Event {ev}?")) return;
        events.Remove(ev);
        PersistWorkspace();
        StateHasChanged();
    }

    private bool AddAutomaton(IEnumerable<DeterministicFiniteAutomaton> aut, bool closeEditor = true)
    {
        workspaceError = "";
        var additions = aut.ToArray();
        var duplicate = additions.Select(g => g.Name).FirstOrDefault(name => string.IsNullOrWhiteSpace(name) || automata.ContainsKey(name));
        if (duplicate is not null)
        {
            workspaceError = string.IsNullOrWhiteSpace(duplicate) ? "Automaton name cannot be blank." : $"An automaton named '{duplicate}' already exists.";
            return false;
        }
        foreach (var G in additions)
            foreach (var e in G.Events)
                if (events.TryGetValue(e.ToString(), out var global) && global.IsControllable != e.IsControllable)
                {
                    workspaceError = $"Event '{e}' has different controllability in the workspace; the automaton was not added.";
                    return false;
                }

        foreach (var G in additions)
        {
            foreach (var q in G.States) states.TryAdd(q.ToString(), q);
            foreach (var e in G.Events) events.TryAdd(e.ToString(), e);
            automata.Add(G.Name, G);
            automatonIds[G.Name] = Guid.NewGuid().ToString("N");
        }
        if (closeEditor) page = Page.Empty;
        PersistWorkspace();
        StateHasChanged();
        return true;
    }

    private bool AddAutomaton(DeterministicFiniteAutomaton value, bool closeEditor, string stableId)
    {
        if (!AddAutomaton(new[] { value }, closeEditor)) return false;
        automatonIds[value.Name] = stableId;
        return true;
    }

    private async void RemoveAutomaton(string aut)
    {
        if (!await JsRuntime.Confirm($"Delete Automaton {aut}?")) return;
        automata.Remove(aut);
        if (automatonIds.Remove(aut, out var id)) layouts.Remove(id);
        PersistWorkspace();
        StateHasChanged();
    }

    private void ShowAutomaton(DeterministicFiniteAutomaton G)
    {
        if (renderingAutomaton || confirmationAutomaton is not null) return;

        var stateCount = G.States.Count();
        if (stateCount > 100)
        {
            confirmationAutomaton = G;
            confirmationStateCount = stateCount;
            return;
        }

        OpenAutomaton(G, stateCount, false);
    }

    private void ConfirmLargeAutomaton()
    {
        if (confirmationSubmitting || confirmationAutomaton is null) return;

        confirmationSubmitting = true;
        var selectedAutomaton = confirmationAutomaton;
        var selectedStateCount = confirmationStateCount;
        confirmationAutomaton = null;
        OpenAutomaton(selectedAutomaton, selectedStateCount, true);
        confirmationSubmitting = false;
    }

    private void CancelLargeAutomaton()
    {
        if (confirmationSubmitting) return;
        confirmationAutomaton = null;
        confirmationStateCount = 0;
    }

    private void OpenAutomaton(DeterministicFiniteAutomaton selectedAutomaton, int stateCount, bool confirmed)
    {
        automaton = selectedAutomaton;
        automatonStateCount = stateCount;
        largeAutomatonConfirmed = confirmed;
        page = Page.ShowAutomaton;
    }

    private void SetRenderingState(bool isRendering) => renderingAutomaton = isRendering;

    private void CloseAutomaton()
    {
        if (!renderingAutomaton) Clear();
    }

    private bool CanOpenVisualLayout(DeterministicFiniteAutomaton value) =>
        layouts.ContainsKey(automatonIds[value.Name]) || AutomatonLayoutService.CanConvert(value);

    private string VisualLayoutTitle(DeterministicFiniteAutomaton value) => CanOpenVisualLayout(value)
        ? "Open or convert to a visual layout"
        : $"Visual conversion supports at most {AutomatonLayoutService.MaximumStateCount} states.";

    private async Task OpenVisualLayout(DeterministicFiniteAutomaton value)
    {
        if (layoutGenerating) return;
        automaton = value;
        var id = automatonIds[value.Name];
        if (!layouts.TryGetValue(id, out activeLayout))
        {
            if (!AutomatonLayoutService.CanConvert(value))
            {
                workspaceError = $"Visual conversion supports at most {AutomatonLayoutService.MaximumStateCount} states. This automaton has {value.States.Count()} states.";
                StateHasChanged();
                return;
            }
            workspaceError = "";
            layoutGenerating = true;
            layoutProgress = "Preparing the automaton…";
            layoutCancellation = new CancellationTokenSource();
            StateHasChanged();
            try
            {
                var progress = new Progress<string>(message => { layoutProgress = message; _ = InvokeAsync(StateHasChanged); });
                activeLayout = await AutomatonLayoutService.CreateAsync(value, progress, layoutCancellation.Token);
                layouts[id] = activeLayout;
                await PersistWorkspaceAsync();
            }
            catch (OperationCanceledException)
            {
                workspaceError = "Visual layout conversion was cancelled.";
                return;
            }
            finally
            {
                layoutGenerating = false;
                layoutCancellation?.Dispose();
                layoutCancellation = null;
            }
        }
        page = Page.EditVisualLayout;
        StateHasChanged();
    }

    private void CancelVisualLayout() => layoutCancellation?.Cancel();

    private Task PersistWorkspaceAsync() => WorkspaceStorage.SaveAsync(states.Values, events.Values, automata.Select(pair =>
    {
        var id = automatonIds[pair.Key];
        layouts.TryGetValue(id, out var layout);
        return new StoredAutomaton(id, DeterministicFiniteAutomaton.ToJsonString(pair.Value), layout);
    }));

    private Task SaveVisualLayout(AutomatonLayoutData layout)
    {
        layouts[automatonIds[automaton.Name]] = layout;
        activeLayout = layout;
        PersistWorkspace();
        Clear();
        return Task.CompletedTask;
    }

    private void VerifyOpacityAutomaton(DeterministicFiniteAutomaton G)
    {
        page = Page.Empty;
        StateHasChanged();
        page = Page.VerifyOpacityAutomaton;
        automaton = G;
        StateHasChanged();
    }

    private void SummaryAutomaton(DeterministicFiniteAutomaton G)
    {
        page = Page.Empty;
        StateHasChanged();
        page = Page.AutomatonSummary;
        automaton = G;
        StateHasChanged();
    }

    private void SaveAutomaton(DeterministicFiniteAutomaton G)
    {
        JsRuntime.SaveFile($"{G.Name}.json", DeterministicFiniteAutomaton.ToJsonString(G));
    }

    private async void LoadJsonAutomaton(string name)
    {
        var json = await JsRuntime.ReadFile(name);
        var aut = DeterministicFiniteAutomaton.FromJsonString(json);
        AddAutomaton(aut);
        StateHasChanged();
    }

    private async void LoadWmodAutomaton(string name)
    {
        var wmod = await JsRuntime.ReadFile(name);
        DeterministicFiniteAutomaton.FromWmodString(wmod, out var p, out var e);
        AddAutomaton(p);
        AddAutomaton(e);
        StateHasChanged();
    }

    private async void LoadAdsAutomaton(string name)
    {
        var ads = await JsRuntime.ReadFile(name);
        var aut = DeterministicFiniteAutomaton.FromAdsString(ads);
        AddAutomaton(new []{aut});
        StateHasChanged();
    }

    private async void LoadXmlAutomaton(string name)
    {
        var xml = await JsRuntime.ReadFile(name);
        var aut = DeterministicFiniteAutomaton.FromXMLString(xml);
        AddAutomaton(new[] { aut });
        StateHasChanged();
    }

    private void LoadSmallFactory()
    {
        var q0 = new State("q0", Marking.Marked); var q1 = new State("q1", Marking.Unmarked);
        var a1 = new Event("a1", Controllability.Controllable); var a2 = new Event("a2", Controllability.Controllable);
        var b1 = new Event("b1", Controllability.Uncontrollable); var b2 = new Event("b2", Controllability.Uncontrollable);
        AddAutomaton(new[] {
            new DeterministicFiniteAutomaton(new Transition[] { (q0, a1, q1), (q1, b1, q0) }, q0, "M1"),
            new DeterministicFiniteAutomaton(new Transition[] { (q0, a2, q1), (q1, b2, q0) }, q0, "M2"),
            new DeterministicFiniteAutomaton(new Transition[] { (q0, b1, q1), (q1, a2, q0) }, q0, "E") });
    }

    private void LoadFlexibleManufacturingSystem()
    {
        var e = new[] { 11, 12, 21, 22, 41, 42, 51, 52, 53, 54, 31, 32, 33, 34, 35, 36, 37, 38, 39, 30, 61, 63, 65, 64, 66, 71, 72, 73, 74, 81, 82 }.ToDictionary(alias => alias, alias => (AbstractEvent)new Event($"{alias}", alias % 2 == 0 ? Controllability.Uncontrollable : Controllability.Controllable));

        var s = Enumerable.Range(0, 6).ToDictionary(i => i, i => new State($"{i}", i == 0 ? Marking.Marked : Marking.Unmarked));

        // C1
        var c1 = new DeterministicFiniteAutomaton(new Transition[] { (s[0], e[11], s[1]), (s[1], e[12], s[0]) }, s[0], "C1");

        // C2
        var c2 = new DeterministicFiniteAutomaton(new Transition[] { (s[0], e[21], s[1]), (s[1], e[22], s[0]) }, s[0], "C2");

        // Lathe
        var lathe = new DeterministicFiniteAutomaton(new Transition[] { (s[0], e[41], s[1]), (s[1], e[42], s[0]) }, s[0], "Lathe");

        // Paint Device
        var pd = new DeterministicFiniteAutomaton(new Transition[] { (s[0], e[81], s[1]), (s[1], e[82], s[0]) }, s[0], "PD");

        // Mill
        var mill = new DeterministicFiniteAutomaton(new Transition[] { (s[0], e[51], s[1]), (s[1], e[52], s[0]), (s[0], e[53], s[2]), (s[2], e[54], s[0]) }, s[0], "Mill");

        // C3
        var c3 = new DeterministicFiniteAutomaton(new Transition[] { (s[0], e[71], s[1]), (s[1], e[72], s[0]), (s[0], e[73], s[2]), (s[2], e[74], s[0]) }, s[0], "C3");

        // Robot
        var robot = new DeterministicFiniteAutomaton(new Transition[] { (s[0], e[31], s[1]), (s[1], e[32], s[0]), (s[0], e[33], s[2]), (s[2], e[34], s[0]), (s[0], e[35], s[3]), (s[3], e[36], s[0]), (s[0], e[37], s[4]), (s[4], e[38], s[0]), (s[0], e[39], s[5]), (s[5], e[30], s[0]) }, s[0], "Robot");

        // Assembly Machine
        var am = new DeterministicFiniteAutomaton(new Transition[] { (s[0], e[61], s[1]), (s[1], e[63], s[2]), (s[1], e[65], s[3]), (s[2], e[64], s[0]), (s[3], e[66], s[0]) }, s[0], "AM");

        // E1
        var e1 = new DeterministicFiniteAutomaton(new Transition[] { (s[0], e[12], s[1]), (s[1], e[31], s[0]) }, s[0], "E1");

        // E2
        var e2 = new DeterministicFiniteAutomaton(new Transition[] { (s[0], e[22], s[1]), (s[1], e[33], s[0]) }, s[0], "E2");

        // E5
        var e5 = new DeterministicFiniteAutomaton(new Transition[] { (s[0], e[36], s[1]), (s[1], e[61], s[0]) }, s[0], "E5");

        // E6
        var e6 = new DeterministicFiniteAutomaton(new Transition[] { (s[0], e[38], s[1]), (s[1], e[63], s[0]) }, s[0], "E6");

        // E3
        var e3 = new DeterministicFiniteAutomaton(new Transition[] { (s[0], e[32], s[1]), (s[1], e[41], s[0]), (s[0], e[42], s[2]), (s[2], e[35], s[0]) }, s[0], "E3");

        // E7
        var e7 = new DeterministicFiniteAutomaton(new Transition[] { (s[0], e[30], s[1]), (s[1], e[71], s[0]), (s[0], e[74], s[2]), (s[2], e[65], s[0]) }, s[0], "E7");

        // E8
        var e8 = new DeterministicFiniteAutomaton(new Transition[] { (s[0], e[72], s[1]), (s[1], e[81], s[0]), (s[0], e[82], s[2]), (s[2], e[73], s[0]) }, s[0], "E8");

        // E4
        var e4 = new DeterministicFiniteAutomaton(new Transition[] { (s[0], e[34], s[1]), (s[1], e[51], s[0]), (s[1], e[53], s[0]), (s[0], e[52], s[2]), (s[2], e[37], s[0]), (s[0], e[54], s[3]), (s[3], e[39], s[0]) }, s[0], "E4");

        var aut = new[] { c1, c2, lathe, mill, robot, am, c3, pd, e1, e2, e3, e4, e5, e6, e7, e8 };

        AddAutomaton(aut);
    }


