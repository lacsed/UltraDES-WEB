<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <UserSecretsId>70565597-a983-49b4-aca7-3b2526e94910</UserSecretsId>
    <OutputType>Exe</OutputType>
    <DefaultItemExcludes>$(DefaultItemExcludes);test-results/**;playwright-report/**;.cache/**;node_modules/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Opt in on publish; normal builds and tests do not require wasm-tools. -->
  <PropertyGroup Condition="'$(EnableWasmAot)' == 'true'">
    <RunAOTCompilation>true</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
    <PackageReference Include="UltraDES" Version="2.2.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="UltraDESWeb.Tests/**/*.cs" />
    <Content Remove="UltraDESWeb.Tests/**" />
    <None Remove="UltraDESWeb.Tests/**" />
  </ItemGroup>

</Project>
